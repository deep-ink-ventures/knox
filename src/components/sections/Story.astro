---
import SectionHeading from '../ui/SectionHeading.astro';
import SideQuote from '../ui/SideQuote.astro';
import { contentFor } from '../../i18n/index.ts';

const t = contentFor(Astro.currentLocale);
---

<section id="synopsis" class="section" aria-labelledby="synopsis-heading">
  <div class="container">
    <SectionHeading eyebrow={t.story.eyebrow}>
      <span id="synopsis-heading">
        {t.story.headingLead} <span class="the-earth">{t.story.headingAccent}</span>
      </span>
    </SectionHeading>

    <div class="story-grid">
      <div class="story-prose" data-reveal>
        {t.story.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      <aside class="story-aside">
        <SideQuote attribution="Dr. Schnaizer" accent="var(--cyan)" align="right">
          <Fragment set:html={t.story.quotes.schnaizer} />
        </SideQuote>

        <div class="origin panel" data-reveal style="--reveal-delay: 200ms">
          <h3>{t.story.origin.title}</h3>
          <p>{t.story.origin.text}</p>
        </div>

        <SideQuote attribution="Knox" accent="var(--cyan-bright)" align="right">
          <Fragment set:html={t.story.quotes.knox} />
        </SideQuote>

        <SideQuote attribution="Vox" accent="var(--cyan-bright)" align="left">
          <Fragment set:html={t.story.quotes.vox} />
        </SideQuote>
      </aside>
    </div>
  </div>
</section>

<style>
  .the-earth {
    color: var(--cyan);
    text-shadow: 0 0 26px color-mix(in srgb, var(--cyan) 45%, transparent);
    white-space: nowrap;
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: start;
  }

  .story-prose {
    display: grid;
    gap: 1.4rem;
    font-size: var(--text-lg);
    color: var(--ink-dim);
    max-width: 58ch;
  }

  /* per set:html eingefügtes Markup trägt kein Scope-Attribut → :global */
  .story-prose :global(em) {
    color: var(--cyan-bright);
    font-style: italic;
  }

  .story-aside {
    display: grid;
    gap: 2rem;
  }

  /* Im Aside übernimmt das Grid-Gap die Abstände der Zitate */
  .story-aside :global(.side-quote) {
    margin-block: 0;
  }

  .origin {
    padding: clamp(1.6rem, 1.3rem + 1.5vw, 2.4rem);
    display: grid;
    gap: 1rem;
  }

  .origin p {
    color: var(--ink-dim);
    font-size: 0.98rem;
  }

  @media (max-width: 880px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
