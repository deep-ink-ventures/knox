---
import SectionHeading from '../ui/SectionHeading.astro';
import { contentFor, type MemberId } from '../../i18n/index.ts';

const t = contentFor(Astro.currentLocale);

/* Finale Viten (Stand 15.06.2026) – Texte in src/i18n/content/{de,en}.ts. */
const team: { id: MemberId; name: string }[] = [
  { id: 'eva', name: 'Eva Strasser' },
  { id: 'stephen', name: 'Stephen Sundberg' },
];
---

<section id="vita" class="section" aria-labelledby="vita-heading">
  <div class="container">
    <SectionHeading eyebrow={t.team.eyebrow}>
      <span id="vita-heading">{t.team.heading}</span>
    </SectionHeading>

    <div class="team-grid">
      {
        team.map((person, index) => (
          <article class="member panel" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
            <p class="member-role eyebrow">{t.team.members[person.id].role}</p>
            <h3>{person.name}</h3>
            <p class="member-text">{t.team.members[person.id].text}</p>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .member {
    padding: clamp(1.8rem, 1.4rem + 2vw, 2.8rem);
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .member-role {
    font-size: 0.64rem;
  }

  .member:nth-child(2) .member-role {
    color: var(--amber);
  }

  .member-text {
    color: var(--ink-dim);
    font-size: 0.98rem;
  }

  @media (max-width: 720px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
