---
import SectionHeading from '../ui/SectionHeading.astro';
import { contentFor, type FotoSlug } from '../../i18n/index.ts';

const t = contentFor(Astro.currentLocale);

/* Fotos der Workshop-Präsentation, selbst gehostet unter public/assets/img/fotos/.
   Gemischte Hoch-, Quer- und Quadratformate – das Masonry-Raster bewahrt jedes
   Seitenverhältnis, damit keine Gesichter beschnitten werden. Alt-Texte: src/i18n/content. */
const fotos: [FotoSlug, number, number][] = [
  ['live-band', 800, 1423],
  ['ensemble-buehne', 800, 534],
  ['kostuemprobe', 800, 1067],
  ['ensemble-lesung', 800, 1067],
  ['team-selfie', 800, 800],
  ['backstage-schlagzeug', 800, 1067],
  ['ensemble-gruppe', 800, 534],
  ['kuenstler-backstage', 800, 1067],
  ['textbuch', 800, 1423],
];
---

<section id="fotos" class="section" aria-labelledby="fotos-heading">
  <div class="container">
    <SectionHeading eyebrow={t.fotos.eyebrow}>
      <span id="fotos-heading">{t.fotos.heading}</span>
    </SectionHeading>

    <p class="fotos-lead" data-reveal>{t.fotos.lead}</p>

    <ul class="fotos-grid" role="list">
      {
        fotos.map(([slug, width, height], index) => (
          <li class="foto panel" data-reveal style={`--reveal-delay: ${(index % 3) * 70}ms`}>
            <img
              src={`/assets/img/fotos/${slug}.webp`}
              width={width}
              height={height}
              alt={t.fotos.alts[slug]}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>

    <p class="fotos-credit" data-reveal>{t.fotos.credit}</p>
  </div>
</section>

<style>
  .fotos-lead {
    max-width: 52ch;
    color: var(--ink-dim);
    margin-bottom: 2.4rem;
  }

  /* Masonry per CSS-Spalten: bewahrt jedes Seitenverhältnis ohne Zuschnitt. */
  .fotos-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 1;
    column-gap: 1.2rem;
  }

  @media (min-width: 560px) {
    .fotos-grid {
      columns: 2;
    }
  }

  @media (min-width: 900px) {
    .fotos-grid {
      columns: 3;
    }
  }

  .foto {
    break-inside: avoid;
    margin-bottom: 1.2rem;
    overflow: clip;
  }

  .foto img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .foto:hover img {
    transform: scale(1.035);
  }

  .fotos-credit {
    margin-top: 1.2rem;
    font-size: 0.92rem;
    color: var(--ink-faint);
  }
</style>
