---
import { LOCALES, LOCALE_META, ROUTES, contentFor, toLocale, type RouteKey } from '../../i18n/index.ts';

interface Props {
  route: RouteKey;
}

const { route } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = contentFor(Astro.currentLocale);
---

<nav class="lang-switch" aria-label={t.ui.languageNav}>
  <ul role="list">
    {
      LOCALES.map((lang) => (
        <li>
          <a
            href={ROUTES[route][lang]}
            hreflang={lang}
            lang={lang}
            aria-label={LOCALE_META[lang].name}
            aria-current={lang === locale ? 'page' : undefined}
            data-lang-link={lang}
          >
            {LOCALE_META[lang].short}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { LANG_STORAGE_KEY } from '../../i18n/config.ts';

  /* Gilt für alle Sprachlinks der Seite (Umschalter oben und Fußzeile). */
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(LANG_STORAGE_KEY, link.dataset.langLink ?? '');
      } catch {
        // Speicher blockiert: Der Same-Origin-Referrer verhindert trotzdem eine Rück-Weiterleitung.
      }
      // Die Sektions-IDs sind in beiden Sprachen gleich – man bleibt an derselben Stelle.
      if (location.hash) link.hash = location.hash;
    });
  }
</script>

<style>
  .lang-switch {
    position: absolute;
    z-index: 10;
    top: clamp(0.9rem, 0.6rem + 1vw, 1.6rem);
    /* bündig mit der rechten Kante des Inhalts-Containers */
    right: max(1.375rem, (100% - var(--container)) / 2);
  }

  ul {
    display: flex;
    gap: 0.2rem;
    padding: 0.22rem;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(8px);
  }

  a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2rem;
    padding-inline: 0.75rem 0.55rem; /* gleicht das Letter-Spacing nach dem letzten Buchstaben aus */
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  a:hover {
    color: var(--cyan-bright);
    background: color-mix(in srgb, var(--cyan) 7%, transparent);
  }

  a:focus-visible {
    border-radius: 999px;
  }

  a[aria-current='page'] {
    color: var(--cyan-bright);
    background: color-mix(in srgb, var(--cyan) 16%, transparent);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
</style>
