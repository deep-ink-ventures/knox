---
import { LOCALES, LOCALE_META, ROUTES, contentFor, toLocale, type RouteKey } from '../i18n/index.ts';

interface Props {
  route: RouteKey;
}

const { route } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = contentFor(Astro.currentLocale);
const otherLocales = LOCALES.filter((lang) => lang !== locale);
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-brand">© 2026 KNOX — Eva Strasser &amp; Stephen Sundberg</p>
    <nav aria-label={t.ui.footerNav}>
      <a href={ROUTES.legalNotice[locale]}>{t.ui.legalNotice}</a>
      <a href={ROUTES.privacy[locale]}>{t.ui.privacy}</a>
      {
        otherLocales.map((lang) => (
          <a href={ROUTES[route][lang]} hreflang={lang} lang={lang} data-lang-link={lang}>
            {LOCALE_META[lang].name}
          </a>
        ))
      }
      <a href="#top">{t.ui.backToTop}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 2.2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand {
    font-family: var(--font-label);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.8rem;
  }

  nav a {
    font-size: 0.85rem;
    color: var(--ink-dim);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--cyan-bright);
  }
</style>
